# Template for /etc/url-shortener/app.env on the EC2 instance.
#
# Install as root:  install -o root -g app -m 640 app.env /etc/url-shortener/app.env
#
# This file is read by both the systemd unit (EnvironmentFile=) and deploy.sh (before the
# migration), so the app and the migration always see the same settings.
#
# NO SECRETS GO HERE. The database password is fetched from SSM Parameter Store at startup
# using the instance role; only the parameter *name* is listed below.

PORT=3000
HOST=127.0.0.1
BASE_URL=https://go.shruthic.me

DB_HOST=<rds-endpoint>.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=urlshortener
DB_USER=shortener
DB_PASSWORD_PARAM=/url-shortener/db-password

DB_SSL=true
DB_SSL_CA_PATH=/etc/url-shortener/rds-ca-bundle.pem

AWS_REGION=us-east-2
